# Railway / Dokploy Build Configuration
# Ref: https://railway.app/docs/deploy/railway-json

[build]
builder = "NIXPACKS"
buildCommand = "bun install && bun run build"

[deploy]
startCommand = "bun run preview --host 0.0.0.0 --port ${PORT:-3000}"
healthCheckPath = "/"
restartPolicy = "on-failure"

[envs]
NODE_ENV = "production"
