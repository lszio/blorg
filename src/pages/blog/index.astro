---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import AppSidebar from '../../components/layout/AppSidebar.astro';
import { GlobalConsole } from '../../components/interactive/GlobalConsole';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.createTime.valueOf() - a.data.createTime.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-fixed bg-cover flex h-screen text-foreground selection:bg-primary/20">
		<AppSidebar />
		<main class="flex-1 overflow-y-auto relative pt-16 pb-32 scroll-smooth">
			<div class="max-w-4xl mx-auto px-12">
				<header class="mb-16">
					<h1 class="text-6xl font-extrabold tracking-tighter mb-4 gradient-text">Blog</h1>
					<p class="text-2xl text-muted-foreground leading-relaxed max-w-2xl">{SITE_DESCRIPTION}</p>
				</header>

				<section class="space-y-8">
					<div class="grid gap-4">
						{posts.map(post => (
							<a href={`/blog/${post.id}`} class="glass p-6 rounded-2xl hover:bg-white/10 transition-all flex justify-between items-center group">
								<div>
									<h3 class="text-xl font-bold">{post.data.title}</h3>
									<p class="text-sm opacity-50">{post.data.summary}</p>
								</div>
								<span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
							</a>
						))}
					</div>
				</section>
			</div>
		</main>
		<GlobalConsole client:load />
	</body>
</html>

<style>
	.gradient-text {
		background: linear-gradient(to right, var(--color-primary), #6366f1);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
