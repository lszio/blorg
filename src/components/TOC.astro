---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<nav id="toc" class="toc glass p-6 rounded-2xl shadow-sm">
  <h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-4 flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
    Contents
  </h2>
  {
    headings.length === 0 ? (
      <ul class="space-y-3">
        <li class="text-sm text-muted-foreground italic opacity-50">No headings found</li>
      </ul>
    ) : (
      <ul id="toc-list" class="space-y-3">
        {headings.map(h => (
          <li class={`toc-item depth-${h.depth}${h.depth === 3 ? ' ml-4' : ''}`}>
            <a
              href={`#${h.slug}`}
              class="text-sm text-foreground/70 hover:text-primary hover:translate-x-1 transition-all block leading-tight border-l-2 border-transparent hover:border-primary/30 pl-3"
            >{h.text}</a>
          </li>
        ))}
      </ul>
    )
  }
</nav>

<!-- Active heading tracking via IntersectionObserver (client-only enhancement) -->
<script>
  function initScrollTracking() {
    const tocList = document.getElementById('toc-list');
    if (!tocList) return;

    const links = Array.from(tocList.querySelectorAll('a'));
    const headings = links
      .map(a => {
        const id = a.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean) as HTMLElement[];

    if (headings.length === 0) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        const link = tocList.querySelector(`a[href="#${id}"]`);
        if (entry.isIntersecting) {
          links.forEach(l => l.classList.remove('text-primary', 'border-primary', 'font-medium'));
          link?.classList.add('text-primary', 'border-primary', 'font-medium');
        }
      });
    }, { rootMargin: '-100px 0px -66%' });

    headings.forEach(h => observer.observe(h));
  }

  initScrollTracking();
  document.addEventListener('astro:after-swap', initScrollTracking);
</script>

<style>
  .toc {
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
  }
  .toc::-webkit-scrollbar {
    display: none;
  }
  .toc {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .toc-item a.font-medium {
    border-left-color: var(--color-primary);
  }
</style>