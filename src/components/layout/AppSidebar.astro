---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const { pathname } = Astro.url;
---

<aside class="w-[260px] h-full glass-dark border-r border-white/10 flex flex-col text-white">
  <div class="p-6 border-b border-white/10">
    <a href="/" class="flex items-center gap-3 no-underline">
      <div class="size-8 bg-primary rounded-lg flex items-center justify-center font-bold text-lg">B</div>
      <span class="font-bold tracking-tight text-xl">{SITE_TITLE}</span>
    </a>
  </div>
  
  <nav class="flex-1 flex flex-col gap-1 p-4 overflow-y-auto">
    <div class="px-3 mb-2 text-[10px] font-bold tracking-widest uppercase opacity-40">Chapters</div>
    {posts.map(post => {
      const isActive = pathname.includes(post.id);
      return (
        <a 
          href={`/blog/${post.id}`} 
          class:list={[
            "px-3 py-2 rounded-lg transition-all text-sm flex items-center gap-3",
            isActive ? "bg-white/10 text-white shadow-sm" : "text-white/60 hover:bg-white/5 hover:text-white"
          ]}
        >
          <span class="size-1.5 rounded-full bg-primary/40 shrink-0" />
          <span class="truncate">{post.data.title}</span>
        </a>
      );
    })}
  </nav>

  <div class="p-4 border-t border-white/10 flex flex-col gap-2">
    <div class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-white/10 transition-colors cursor-pointer">
       <div class="size-8 rounded-full bg-gradient-to-tr from-orange-400 to-rose-400"></div>
       <div class="flex flex-col">
         <span class="text-sm font-medium">Guest User</span>
         <span class="text-xs text-white/40">Settings</span>
       </div>
    </div>
  </div>
</aside>
