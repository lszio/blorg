---
import { SITE_TITLE } from '../../consts';
---

<aside class="w-[260px] h-full glass-dark border-r border-white/10 flex flex-col text-white">
  <div class="p-6 border-b border-white/10">
    <a href="/" class="flex items-center gap-3 no-underline">
      <div class="size-8 bg-primary rounded-lg flex items-center justify-center font-bold text-lg">B</div>
      <span class="font-bold tracking-tight text-xl">{SITE_TITLE}</span>
    </a>
  </div>
  
  <nav class="flex-1 overflow-y-auto p-4 flex flex-col gap-2">
    <!-- Placeholder for navigation items -->
    <div class="px-3 py-2 text-xs font-semibold text-white/40 uppercase tracking-wider">Workspace</div>
    <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-white/10 transition-colors bg-white/5">
      <span class="size-4 rounded-sm bg-blue-500/50"></span>
      <span>Dashboard</span>
    </a>
    <a href="/blog" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-white/10 transition-colors">
      <span class="size-4 rounded-sm bg-purple-500/50"></span>
      <span>Knowledge Base</span>
    </a>
    <a href="/about" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-white/10 transition-colors">
      <span class="size-4 rounded-sm bg-emerald-500/50"></span>
      <span>About Me</span>
    </a>
  </nav>

  <div class="p-4 border-t border-white/10 flex flex-col gap-2">
    <div class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-white/10 transition-colors cursor-pointer">
       <div class="size-8 rounded-full bg-gradient-to-tr from-orange-400 to-rose-400"></div>
       <div class="flex flex-col">
         <span class="text-sm font-medium">Guest User</span>
         <span class="text-xs text-white/40">Settings</span>
       </div>
    </div>
  </div>
</aside>
